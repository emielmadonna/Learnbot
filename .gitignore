# Hosted Supabase release inputs and generated evidence are operator-local.
# The example approval is tracked; real approvals may contain internal metadata.
infra/supabase/release/*.approval.json
infra/supabase/.release-evidence/
infra/supabase/.temp/
# The CLI also writes scratch state one level deeper when it is invoked from
# inside infra/supabase, which the pattern above does not reach. Contains the
# linked project ref and local service versions -- machine state, not source.
infra/supabase/supabase/
# ...and at the repo root, when the CLI is invoked from there.
/supabase/
.vercel
