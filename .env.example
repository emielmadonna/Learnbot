# Public deployment metadata. Do not put credentials in this file.
NODE_ENV=production

# Private fixture preview only. Keep both unset for real production.
# The deployment must also be protected by host-level private access.
# LEARNINGBOT_FIXTURE_PREVIEW=enabled
# LEARNINGBOT_FIXTURE_PREVIEW_ACKNOWLEDGEMENT=I_UNDERSTAND_THIS_USES_EPHEMERAL_FIXTURES

# Durable services (not wired yet).
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Identity and secret references (not wired yet).
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_VAULT_REF=
# PROVIDER_CREDENTIAL_VAULT_REF=

# Public origin used for callbacks and signed links.
# LEARNINGBOT_PUBLIC_ORIGIN=https://learning.example.com
