# Public deployment metadata. Do not put credentials in this file.
NODE_ENV=production

# Private fixture preview only. Keep both unset for real production.
# The deployment must also be protected by host-level private access.
# LEARNINGBOT_FIXTURE_PREVIEW=enabled
# LEARNINGBOT_FIXTURE_PREVIEW_ACKNOWLEDGEMENT=I_UNDERSTAND_THIS_USES_EPHEMERAL_FIXTURES

# Durable Supabase Auth. The publishable key is intentionally browser-safe and
# remains constrained by the signed-in user's JWT plus RLS. Never substitute a
# secret/service-role key in a NEXT_PUBLIC_* value.
# DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Identity and secret references. The verifier contract exists; application
# wiring and an approved IdP registration are still required.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_JWKS_URL=
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_MAX_TOKEN_AGE_SECONDS=300
# OIDC_CLIENT_SECRET_VAULT_REF=
# PROVIDER_CREDENTIAL_VAULT_REF=

# Provider model/SKU selection belongs to tenant route policy. Never put a
# long-lived API key in any NEXT_PUBLIC_* variable.
# OPENAI_API_KEY_VAULT_REF=

# Public origin used for callbacks and signed links.
# LEARNINGBOT_PUBLIC_ORIGIN=https://learning.example.com
